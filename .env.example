# ISSA AS — environment template. Copy to `.env` (git-ignored) and fill in values.
# Never commit real values. Every variable below is read with os.environ at call time.

# Meta Model API key for muse-spark-1.3 / muse-spark-1.3-contributor (OpenAI-compatible, https://api.meta.ai/v1).
MODEL_API_KEY=

# Optional hosted Spark Open provider (OpenAI-compatible) for the triage/critic stages.
# When SPARK_OPEN_API_KEY is set and SPARK_OPEN_BASE_URL is empty, the base URL
# defaults to the Baseten endpoint below; set SPARK_OPEN_BASE_URL explicitly
# only for a custom endpoint. Trace events record provider "baseten" for the
# default and "custom" for an explicit URL.
# Live-verified: Baseten endpoint is https://inference.baseten.co/v1 with
# Authorization: Bearer <key>; every request sends reasoning_effort explicitly
# (the provider defaults to xhigh when it is omitted).
SPARK_OPEN_BASE_URL=
SPARK_OPEN_API_KEY=
# Spark Open model id. Default: meta-models/muse-spark-open.
# NOTE: the hackathon guide's id meta-models/muse-spark-open-1026 returns
# HTTP 404 "please check the model you provided" on this account — use it
# only if your account serves it.
SPARK_OPEN_MODEL=
# Hosted Spark Open prices in USD per 1M tokens (used for cost estimates in traces).
SPARK_OPEN_PRICE_IN_PER_1M=
SPARK_OPEN_PRICE_OUT_PER_1M=

# Override for the Muse CLI binary used by `issa solve` (else resolved via PATH).
# Needed on Windows, where `muse` is a `muse.cmd` shim that subprocess
# cannot start by bare name. Example: MUSE_BIN=C:\Users\24\AppData\Local\Programs\muse\muse.cmd
MUSE_BIN=

# Optional GitHub token for the deterministic scout's search API (higher rate limits).
# A fine-grained token with public repositories read-only and no other permissions
# is enough. Used only by the deterministic scout; never passed to any model (the
# solver strips it from the `muse exec` child environment). Only whether it is set
# (authenticated or not) is recorded in reports and traces, never the value.
# Also used by the human-approved `issa publish` command (dry-run by default).
GITHUB_TOKEN=
