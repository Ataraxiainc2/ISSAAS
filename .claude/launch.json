{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "muse-console",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "tools/console/server.py"
      ],
      "port": 8765
    },
    {
      "name": "issasodaweb",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8790",
        "--bind",
        "127.0.0.1",
        "--directory",
        "D:/SC/issasodaweb.com/GUAT"
      ],
      "port": 8790
    },
    {
      "name": "issa-serve",
      "runtimeExecutable": "D:/SC/ISSAAS/.tools/uv.exe",
      "runtimeArgs": [
        "run",
        "issa",
        "serve",
        "--port",
        "8780"
      ],
      "port": 8780
    },
    {
      "name": "issa-serve-nosync",
      "runtimeExecutable": "D:/SC/ISSAAS/.tools/uv.exe",
      "runtimeArgs": [
        "run",
        "--no-sync",
        "python",
        "-c",
        "import sys; from issa_as.cli import main; sys.exit(main(['serve','--port','8782']))"
      ],
      "port": 8782,
      "autoPort": false
    }
  ]
}
