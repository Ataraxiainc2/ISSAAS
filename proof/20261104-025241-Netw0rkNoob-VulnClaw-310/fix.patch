         self._status_printed = False
 
 
+def build_stream_findings(
+    agent_state: dict[str, Any] | None,
+    target: str,
+) -> list[dict[str, Any]]:
+    """Map a CLI summary dict onto Rust TUI ``finding`` entries.
+
+    ``AgentState.get_summary()`` reports ``verified_claims`` as an int count,
+    so slicing it like a claim list crashed every successful ``--stream`` run
+    before ``complete`` was emitted (#310). Degrade non-list shapes to no
+    findings instead of raising; list shapes keep the historical mapping.
+    """
+    claims = (agent_state or {}).get("verified_claims")
+    if not isinstance(claims, list):
+        return []
+    findings: list[dict[str, Any]] = []
+    for idx, claim in enumerate(claims[:50], start=1):
+        if isinstance(claim, dict):
+            findings.append(
+                {
+                    "id": claim.get("id") or f"v{idx:03d}",
+                    "severity": "high",
+                    "title": str(claim.get("claim") or "")[:200],
+                    "target": target,
+                }
+            )
+    return findings
+
+
 def emit_complete_event(
     stream: Any,
     *,
