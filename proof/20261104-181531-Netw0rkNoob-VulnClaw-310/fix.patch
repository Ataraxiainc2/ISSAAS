     stream.flush()
 
 
+def build_stream_findings(
+    agent_state: Mapping[str, Any] | None, target: str
+) -> list[dict[str, Any]]:
+    """Map verified claims onto the TUI finding list.
+
+    ``AgentState.get_summary()`` reports ``verified_claims`` as an int
+    count, while older summaries may carry the claim-dict list itself.
+    Anything that is not a list of claim dicts degrades to an empty
+    finding list instead of raising ``TypeError``.
+    """
+    claims = (agent_state or {}).get("verified_claims")
+    if not isinstance(claims, list):
+        return []
+    findings: list[dict[str, Any]] = []
+    for idx, claim in enumerate(claims[:50], start=1):
+        if isinstance(claim, dict):
+            findings.append(
+                {
+                    "id": claim.get("id") or f"v{idx:03d}",
+                    "severity": "high",
+                    "title": str(claim.get("claim") or "")[:200],
+                    "target": target,
+                }
+            )
+    return findings
+
+
